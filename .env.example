# ---- Public (exposed to the browser — never put secrets here) ----
NEXT_PUBLIC_SITE_URL=https://voltaris.rw
NEXT_PUBLIC_API_BASE_URL=https://api.voltaris.rw/v1
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.voltaris.rw
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=https://voltaris-mobility-backend.onrender.com

# ---- Server-only (never prefixed NEXT_PUBLIC_) ----
# Used for server-side rendering calls that must not traverse the public internet.
API_INTERNAL_BASE_URL=http://voltaris-api.internal:8080/v1
API_SERVER_TIMEOUT_MS=8000

# Payment provider publishable key only. Secret keys live in the backend.
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# Revalidation webhook shared secret (backend -> frontend cache purge)
REVALIDATE_SECRET=

# --- Hero media -------------------------------------------------------------
# Optional. Set to a CDN path WITHOUT the extension; the player appends `.webm`
# and `.mp4` and picks whichever the browser supports:
#   NEXT_PUBLIC_HERO_VIDEO_URL=https://media.voltaris.rw/hero/showroom-orbit
#
# Leave blank and the still image is used alone. There is no placeholder video —
# an absent file would show a black rectangle where the hero should be.
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- Feature flags ----------------------------------------------------------
# All default OFF. Turn one on only after the backend capability behind it
# exists — a dead "Buy" button costs more trust than no button at all.
#
# checkout          needs a real payment provider adapter (StubProvider refuses
#                   to run in production)
# seller_listings   needs POST /seller-listings; media upload already works
# password_reset    needs an email transport, or the link sends nothing
# rentals           needs an availability calendar, not just a daily price
NEXT_PUBLIC_FEATURE_CHECKOUT=false
NEXT_PUBLIC_FEATURE_SELLER_LISTINGS=false
NEXT_PUBLIC_FEATURE_PASSWORD_RESET=false
NEXT_PUBLIC_FEATURE_RENTALS=false
