{
  "ci": {
    "collect": {
      "startServerCommand": "NEXT_PUBLIC_DEMO_DATA=true npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/cars",
        "http://localhost:3000/cars/mercedes-eqs-2023-kigali",
        "http://localhost:3000/finance",
        "http://localhost:3000/garage"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 360, "height": 640, "deviceScaleFactor": 3 },
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 7.0; Moto G (4)) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36",
        "throttlingMethod": "simulate",
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4 }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 256000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
